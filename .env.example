# SkyPulse API keys - copy this file to .env and fill in.
# NEVER commit .env and never paste keys into chat.

# LIVE FLIGHT PRICES (tried in this order, both free, no card)
# 1) https://www.searchapi.io  -> 100 free searches/month
SEARCHAPI_KEY=
# 2) https://serpapi.com       -> 250 free searches/month (backup)
SERPAPI_KEY=

# Optional: flight schedules/status
AVIATIONSTACK_KEY=

PORT=3000
